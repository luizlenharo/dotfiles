#!/usr/bin/env bash
# Custom Claude Desktop launcher for Hyprland/Wayland
# Mimics johnzfitch/claude-cowork-linux's minimal Wayland approach,
# which renders correctly under fractional scaling.

export ELECTRON_FORCE_IS_PACKAGED=true
export ELECTRON_USE_SYSTEM_TITLE_BAR=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland

APP_DIR=/usr/lib/claude-desktop
ELECTRON_BIN="$APP_DIR/node_modules/electron/dist/electron"
APP_ASAR="$APP_DIR/node_modules/electron/dist/resources/app.asar"

cd "$HOME" || exit 1

exec "$ELECTRON_BIN" \
    --no-sandbox \
    --enable-features=GlobalShortcutsPortal \
    --class=Claude \
    "$APP_ASAR" "$@"
